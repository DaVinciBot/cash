{
	"extends": ["./.svelte-kit/tsconfig.json", "@davincibot/config/tsconfig"],
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"eslint.config.js",
		"playwright.config.ts",
		"svelte.config.js",
		"vite.config.js",
		"vite.config.ts",
		"vitest.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.js",
		"test/**/*.ts",
		"test/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte"
	]
}
