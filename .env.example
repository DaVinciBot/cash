# Projet Supabase
PUBLIC_SUPABASE_URL=https://project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-anon-key

# Clé secrète Supabase (service role : sb_secret_xx)
SUPABASE_SECRET_KEY=

# Service auth central (prod : https://auth.davincibot.fr)
PUBLIC_AUTH_BASE_URL=http://localhost:5177

# Préfixe optionnel des noms de cookies (ex. dev-) : isole un environnement qui
# partage le domaine racine avec la prod (dev.davincibot.fr). Vide en prod.
PUBLIC_COOKIE_PREFIX=

# L'enrôlement des passkeys et le step-up MFA tournent sur CETTE origine :
# elle doit figurer dans WEBAUTHN_ORIGINS côté auth, sinon l'attestation est
# rejetée (« L'activation a échoué »).

# Adresse par laquelle le serveur s'atteint LUI-MÊME pour produire les PDF des
# documents : le rendu ouvre la page dans un navigateur embarqué, il lui faut
# donc une URL joignable depuis l'intérieur du conteneur — pas l'adresse
# publique, qui repasserait par le proxy.
#
# Facultative : par défaut `http://127.0.0.1:${PORT}`, ce qui convient à
# `node build` comme au conteneur. À ne renseigner que si le serveur écoute
# ailleurs que sur la boucle locale.
# PDF_INTERNAL_BASE=http://127.0.0.1:3000

# Prod uniquement, derrière Traefik (adapter-node) :
# ORIGIN=https://davincibot.fr
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
