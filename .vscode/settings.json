{
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[svelte]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescript]": {
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit",
			"source.fixAll.ts": "explicit"
		},
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"editor.formatOnSave": true,
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.exclude": {
		"**/.svelte-kit": true,
		"**/dist": true,
		"**/build": true
	},
	"eslint.run": "onSave",
	"eslint.workingDirectories": [{ "mode": "auto" }]
}
